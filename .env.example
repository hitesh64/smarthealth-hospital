# Copy this file to .env and fill in the values. .env holds passwords - never commit it.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=hospital_db

# MONGO_URI on a host such as Render: leave it empty or localhost to run MongoDB inside the Docker
# container (add a persistent disk at /data, or the data is lost on every restart), or use a
# MongoDB Atlas mongodb+srv:// link to keep the data in Atlas.

# --- First Super Admin, created only while the database has no staff login (e.g. a new server)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Session cookie key (any long random text). Left empty, one is made and kept in .flask_secret ---
SECRET_KEY=

# --- Email via Gmail SMTP (a Gmail "App password", not the normal password). Empty = mails are only logged ---
MAIL_GMAIL_ADDRESS=
MAIL_GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=SmartHealth Hospital

# --- Google Sign-In client id (must match the one in index.html) ---
GOOGLE_CLIENT_ID=

# --- Hospital: its fixed location is the start of every ambulance route ---
HOSPITAL_NAME=SmartHealth Hospital
HOSPITAL_PHONE=+91 75070 41642
HOSPITAL_ADDRESS=Cross Road B, MIDC, Andheri East, Mumbai, Maharashtra 400096
HOSPITAL_LAT=19.11499
HOSPITAL_LNG=72.86817
# requests further than this (km, straight line) are flagged as outside the service area
SERVICE_RADIUS_KM=40
# road times from the routing server are multiplied by this for city traffic
ROUTE_TRAFFIC_FACTOR=1.35

# --- UPI payment for medicine orders (empty = cash only) ---
UPI_ID=
UPI_PAYEE_NAME=SmartHealth Hospital
UPI_PAY_MINUTES=30

# --- Razorpay online payment (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys for
# test mode. When set, patients pay medicine orders and lab tests online and get an emailed receipt.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SerpApi (serpapi.com) key: real nearby hospitals from Google Maps on the SOS screen. Empty = hidden ---
SERPAPI_KEY=

# --- AI Symptom Checker (Google Gemini). Empty = switched off ---
GEMINI_API_KEY=

# --- Laboratory: home sample collection charge, free above this order value ---
LAB_HOME_COLLECTION_FEE=100
LAB_FREE_COLLECTION_ABOVE=999
