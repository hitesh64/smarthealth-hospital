# Speed: compress text files and let browsers keep static files, so repeat visits do not download them again.
# Every directive is guarded, so a server without the module simply skips it.

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # logos, doctor and medicine photos
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    # stylesheets and scripts are linked with ?v=N - raise N in the HTML whenever one changes
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    # pages and API answers are always fetched fresh
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# never serve the private / helper files, even if one is uploaded by mistake
<FilesMatch "^(settings\.php|settings\.env\.php|render\.env|import_db\.php|.*\.sql|Dockerfile)$">
    Require all denied
</FilesMatch>
